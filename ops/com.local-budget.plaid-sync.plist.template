<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.local-budget.plaid-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@REPO@/ops/budget-plaid-sync.sh</string>
    <string>@VENV@/bin/budget</string>
    <string>@DATA@</string>
  </array>
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>@LOGS@/sync.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/sync.err.log</string>
</dict>
</plist>
